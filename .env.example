# 复制此文件为 .env 并填入实际值（.env 已 gitignore，不会提交）

# Supabase 数据库迁移（run-migration-*.py、run-fix-*.py 所需）
SUPABASE_PROJECT_REF=你的项目ID
SUPABASE_DB_PASSWORD=你的数据库密码

# 后端抓取与重试脚本（main.py、retry_failed_scrapes.py 所需）
# URL 可省略，会从 SUPABASE_PROJECT_REF 自动推导
# SUPABASE_URL=https://你的项目.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Dashboard → Settings → API → service_role key

# LLM API（可选，tools/llm_api.py 等使用）
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# ...
